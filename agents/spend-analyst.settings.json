        "/Users/dwalczyk/.config/codeburn",
        "/Users/dwalczyk/.config/gh/config.yml",
        "/Users/dwalczyk/.config/gh/hosts.yml"
      ],
      "allowWrite": [
        "/Users/dwalczyk/.config/codeburn"
      ],
      "denyWrite": [
        "/Users/dwalczyk/.claude",
        "/Users/dwalczyk/.codex",
        "/Users/dwalczyk/.t3",
        "/Users/dwalczyk/.config/gh",
        "/Users/dwalczyk/.local/state/agents-config",
        "/Users/dwalczyk/Development/agents-config"
