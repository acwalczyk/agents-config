# Local values for agents-config. Copy this file to .env, fill in your values,
# and keep .env out of Git (it is already listed in .gitignore).
# Profile overlays in profiles/claude/ reference these names with ${NAME}
# placeholders; the launchers fail closed when a referenced value is missing.

# EnMaaS gateway endpoint (Anthropic-compatible) used by the EnMaaS profile
ENMAAS_URL=

# Google Cloud project ID used by the Vertex profile
VERTEX_PROJECT_ID=

# Keep credentials out of this file: API keys and tokens stay in the agents'
# native authentication stores.
