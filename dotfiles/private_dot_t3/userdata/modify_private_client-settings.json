{{- /* chezmoi:modify-template */ -}}
{{- $current := dict -}}
{{- if trim .chezmoi.stdin -}}{{- $current = fromJson .chezmoi.stdin -}}{{- end -}}
{{- range $key, $value := (include (joinPath .chezmoi.workingTree "config/t3.json") | fromJson) -}}
{{- if eq $key "providerModelPreferences" -}}
{{- range $id, $preferences := $value -}}
{{- range $setting, $value := $preferences -}}
{{- $current = setValueAtPath (list "providerModelPreferences" $id $setting) $value $current -}}
{{- end -}}
{{- end -}}
{{- else -}}
{{- $current = setValueAtPath (list $key) $value $current -}}
{{- end -}}
{{- end -}}
{{ $current | toPrettyJson }}
